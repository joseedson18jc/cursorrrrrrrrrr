# Vercel container image for the FastAPI backend.
#
# Same slim build as Dockerfile.render (no Playwright/Chromium — the LiveUAmap
# scraper is gated off via LIVEUAMAP_ENABLED=0), but kept as a separate file
# because Vercel detects container services by the `Dockerfile.vercel` name.
FROM python:3.11-slim-bookworm

WORKDIR /app

# curl: network fallback used by services/network_utils.py
# nodejs: AIS WebSocket proxy (ais_proxy.js)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

ENV PYTHONUNBUFFERED=1 \
    LIVEUAMAP_ENABLED=0 \
    PORT=3000

EXPOSE 3000

# Shell form so ${PORT} is expanded at runtime.
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-3000}
