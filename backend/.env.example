# ShadowBroker Backend — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Required Keys ──────────────────────────────────────────────
# Without these, the corresponding data layers will be empty.

OPENSKY_CLIENT_ID=        # https://opensky-network.org/ — free account, OAuth2 client ID
OPENSKY_CLIENT_SECRET=    # OAuth2 client secret from your OpenSky dashboard
AIS_API_KEY=              # https://aisstream.io/ — free tier WebSocket key

# ── Optional ───────────────────────────────────────────────────

# Override allowed CORS origins (comma-separated). Defaults to localhost + LAN auto-detect.
# CORS_ORIGINS=http://192.168.1.50:3000,https://my-domain.com

# Admin key — protects sensitive endpoints (API key management, system update).
# If unset, these endpoints remain open (fine for local dev).
# Set this in production and enter the same key in Settings → Admin Key.
# ADMIN_KEY=your-secret-admin-key-here

# Keyless ships: Fintraffic Digitraffic open AIS (Baltic Sea, ~1,000 vessels)
# runs by default, so the ships layer works with no AIS_API_KEY at all.
# AIS_API_KEY adds the global aisstream.io stream on top. 0 disables Digitraffic.
# DIGITRAFFIC_AIS_ENABLED=1

# LTA_ACCOUNT_KEY is no longer needed: Singapore cameras use the keyless
# data.gov.sg traffic-images endpoint.

# Outbound identification for third-party APIs (adsb.lol, Nominatim, ...).
# Each install sends its own handle as the User-Agent instead of a shared
# project name, so providers can attribute (or limit) operators individually.
# Auto-generated as "operator-xxxxxx" and saved to data/operator_handle.json
# when unset. Set it to your GitHub handle or org name for traceability.
# OPERATOR_HANDLE=your-github-handle
# SHADOWBROKER_USER_AGENT=   # advanced: replace the entire User-Agent string

# LiveUAmap scraper needs a headless Chromium (~300 MB RSS). Set to 0 on small
# cloud instances; the Render/Vercel images already do.
# LIVEUAMAP_ENABLED=1
