# ShadowBroker — Docker Compose Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Required for backend container ─────────────────────────────
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIS_API_KEY=

# ── Optional ───────────────────────────────────────────────────

# LTA (Singapore traffic cameras) — leave blank to skip
# LTA_ACCOUNT_KEY=

# Outbound User-Agent handle sent to third-party APIs (adsb.lol, Nominatim...).
# Leave blank to auto-generate "operator-xxxxxx" (persisted in the backend_data
# volume). Set to your GitHub handle or org name for traceability.
# OPERATOR_HANDLE=

# LiveUAmap scraper needs headless Chromium (~300 MB RSS). Set to 0 to disable.
# LIVEUAMAP_ENABLED=1

# Override the backend URL the frontend uses (leave blank for auto-detect)
# NEXT_PUBLIC_API_URL=http://192.168.1.50:8000
